# Ignore Python cache and virtual environments
__pycache__/
*.pyc
*.pyo
*.pyd
venv/
.env

# Ignore git and editor files
.git/
.gitignore
*.swp
*.swo
*.bak
*.tmp
.DS_Store
.idea/
.vscode/

# Ignore test and notebook files
*.ipynb
*.pytest_cache/
tests/

# Ignore user data and logs
*.log
*.sqlite3
*.db

# Ignore model weights except those explicitly copied in Dockerfile
models/
!models/text_encoders/clip_l.safetensors
!models/text_encoders/t5xxl_fp16.safetensors
!models/vae/ae.safetensors
!models/clip_vision/sigclip_vision_patch14_384.safetensors
!models/style_models/flux1-redux-dev.safetensors
!models/diffusion_models/flux1-dev.safetensors
!models/diffusion_models/flux1-canny-dev.safetensors
!models/diffusion_models/flux1-depth-dev.safetensors
!models/diffusion_models/flux1-fill-dev.safetensors
!models/Models/FLO_AI_VectorCharacters_NL_Slow_v2.safetensors

# Ignore everything else not needed for build
*.tar
*.zip
*.7z
*.rar
